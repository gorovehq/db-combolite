build/
db-combolite/build/
*.o
*.a
.claude/
db-combolite/build-rel/
db-combolite/build-demo/
db-combolite/build-demo-rel/
db-combolite/build*/
# Databases and models are never committed: anyone can build their own.
*.cdbarch
*.cdbwork/
*.gguf
# Test data pools: fetched, not committed (Project Gutenberg index and books).
db-combolite/datastore/gutenberg/
# The demo's binary and local data (only data/README.md is tracked).
db-combolite/demo/gutenfree/gutenfree
db-combolite/demo/gutenfree/data/*
!db-combolite/demo/gutenfree/data/README.md
__pycache__/
*.so
*.egg-info/
dist/
# Sub-agent activity log, tailed by the user.
db-combolite/workspace/agents.log
