#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Copies n rows of `words` words from src (packed) to row slots[r] of dst.
layout(push_constant) uniform P {
    uvec2 dst, src, slots;
    uint words, n;
} pc;

void main()
{
    U32 dst = U32(pc.dst), src = U32(pc.src), slots = U32(pc.slots);
    uint total = pc.n * pc.words;
    for (uint t = gl_GlobalInvocationID.x; t < total; t += stride_x()) {
        uint r = t / pc.words, w = t % pc.words;
        dst.v[slots.v[r] * pc.words + w] = src.v[t];
    }
}
