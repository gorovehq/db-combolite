#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Takes query j's keys at or below its prefix under its mask: exactly the
// `want` smallest, unordered, into its segment of out.
layout(push_constant) uniform P {
    uvec2 keys, state, out_keys;
    uint n, seg;
} pc;

void main()
{
    U64 keys = U64(pc.keys), out_keys = U64(pc.out_keys);
    U32 s = U32(pc.state);
    uint j = gl_WorkGroupID.y, b = j * 8u;
    uvec2 prefix = uvec2(s.v[b + S_PREFIX], s.v[b + S_PREFIX + 1u]);
    uvec2 mask = uvec2(s.v[b + S_MASK], s.v[b + S_MASK + 1u]);
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += stride_x()) {
        uvec2 k = keys.v[j * pc.n + i], km = k & mask;
        if (km.y < prefix.y || (km.y == prefix.y && km.x <= prefix.x)) {
            uint at = atomicAdd(s.v[b + S_COUNT], 1u);
            if (at < pc.seg)
                out_keys.v[j * pc.seg + at] = k;
        }
    }
}
