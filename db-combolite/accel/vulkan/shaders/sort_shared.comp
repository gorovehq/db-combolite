#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Bitonic sort of each seg-key segment of out (seg a power of two, at most
// 2048: 16 KB, the least shared memory Vulkan promises), ascending, one
// workgroup per segment.
layout(push_constant) uniform P {
    uvec2 out_keys;
    uint seg;
} pc;

shared uvec2 sk[2048];

void main()
{
    U64 out_keys = U64(pc.out_keys);
    uint base = gl_WorkGroupID.x * pc.seg, t = gl_LocalInvocationID.x;
    for (uint i = t; i < pc.seg; i += gl_WorkGroupSize.x)
        sk[i] = out_keys.v[base + i];
    memoryBarrierShared();
    barrier();
    for (uint k = 2u; k <= pc.seg; k <<= 1) {
        for (uint jj = k >> 1; jj > 0u; jj >>= 1) {
            for (uint i = t; i < pc.seg; i += gl_WorkGroupSize.x) {
                uint l = i ^ jj;
                if (l > i) {
                    uvec2 a = sk[i], b = sk[l];
                    if (key_less(b, a) == ((i & k) == 0u)) {
                        sk[i] = b;
                        sk[l] = a;
                    }
                }
            }
            memoryBarrierShared();
            barrier();
        }
    }
    for (uint i = t; i < pc.seg; i += gl_WorkGroupSize.x)
        out_keys.v[base + i] = sk[i];
}
