#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Starts each query's selection: nothing chosen yet, `want` keys needed;
// done at once when every key is wanted.
layout(push_constant) uniform P {
    uvec2 state;
    uint nq, want, all_keys;
} pc;

void main()
{
    U32 s = U32(pc.state);
    uint j = gl_GlobalInvocationID.x, b = j * 8u;
    if (j >= pc.nq)
        return;
    s.v[b + S_PREFIX] = 0u;
    s.v[b + S_PREFIX + 1u] = 0u;
    s.v[b + S_MASK] = 0u;
    s.v[b + S_MASK + 1u] = 0u;
    s.v[b + S_NEED] = pc.want;
    s.v[b + S_DONE] = pc.all_keys;
    s.v[b + S_COUNT] = 0u;
}
