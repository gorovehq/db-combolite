#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// One step (k, jj) of a bitonic sort over every seg-key segment of out,
// for segments too long for shared memory.
layout(push_constant) uniform P {
    uvec2 out_keys;
    uint seg, total, k, jj;
} pc;

void main()
{
    U64 out_keys = U64(pc.out_keys);
    for (uint t = gl_GlobalInvocationID.x; t < pc.total; t += stride_x()) {
        uint i = t % pc.seg, l = i ^ pc.jj;
        if (l > i) {
            uint base = t - i;
            uvec2 a = out_keys.v[base + i], b = out_keys.v[base + l];
            if (key_less(b, a) == ((i & pc.k) == 0u)) {
                out_keys.v[base + i] = b;
                out_keys.v[base + l] = a;
            }
        }
    }
}
